# --- Mongo (Compose sets host to mongo; do not publish Mongo to the host) ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB=sonic_acme

# --- Organization mailbox (SMTP outbound) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-org-inbox@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# --- Organization mailbox (IMAP inbound) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-org-inbox@gmail.com
IMAP_PASSWORD=your-gmail-app-password
ORG_MAILBOX_ADDRESS=your-org-inbox@gmail.com
IMAP_POLL_INTERVAL_SECONDS=60

# Reminder cooldown per customer (minutes). Cleared on demo reset.
REMINDER_COOLDOWN_MINUTES=5

# --- LLM (OpenAI-compatible base URL: Groq / OpenRouter / Gemini bridge / OpenAI) ---
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_MIN_CONFIDENCE=0.70

# --- Frontend / CORS (loopback only) ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:3000

# Overdue as-of date (YYYY-MM-DD). Leave empty = UTC today
# (data/data-explanation.md has no fixed reference "today").
DEMO_AS_OF_DATE=
