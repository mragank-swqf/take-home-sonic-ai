# --- Mongo ---
# Inside Docker Compose, the backend overrides host to "mongo".
MONGO_URI=mongodb://mongo:27017
MONGO_DB=sonic_acme

# --- Organization mailbox (SMTP outbound) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-org-inbox@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# --- Organization mailbox (IMAP inbound) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-org-inbox@gmail.com
IMAP_PASSWORD=your-gmail-app-password
ORG_MAILBOX_ADDRESS=your-org-inbox@gmail.com

# How often the collections agent polls IMAP (seconds)
IMAP_POLL_INTERVAL_SECONDS=60

# --- LLM (OpenAI-compatible: OpenAI, Groq, OpenRouter, Gemini OpenAI bridge, etc.) ---
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_MIN_CONFIDENCE=0.70

# --- Frontend / CORS ---
# Browser calls the API on the published host port.
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Optional: freeze "today" for overdue demos (YYYY-MM-DD). Leave empty for real UTC date.
DEMO_AS_OF_DATE=
